# Kopieren nach .env. Alles hier ist optional - ohne .env funktioniert
# `docker compose up -d` bereits: der erste registrierte Account wird
# automatisch Admin, und die kuratierte Kanalliste greift automatisch.

# Fester Admin-Account, wird beim Start angelegt (nur falls noch keiner
# existiert). Ohne das übernimmt stattdessen der erste registrierte User
# die Admin-Rolle.
MEMECAL_ADMIN_PASSWORD=

# Fixer Session-Key. Leer => wird einmalig in /data generiert.
# Erzeugen mit: openssl rand -base64 48
MEMECAL_SECRET_KEY=

# Überschreibt die kuratierte Default-Kanalliste aus memecal/config.py.
# Kommasepariert, Einträge als "kanal" oder "kanal:kategorie", Handles
# (@name) und channel_ids (UC...) sind beide erlaubt. Wird nur beim
# allerersten Start übernommen; danach im Admin-UI pflegen.
# Zum Wirksamwerden auch die Zeile in docker-compose.yml einkommentieren.
MEMECAL_DEFAULT_CHANNELS=
